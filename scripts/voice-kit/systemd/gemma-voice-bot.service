[Unit]
Description=Gemma Rust Voice Agent
Wants=network-online.target sound.target
After=network-online.target sound.target

[Service]
Type=simple
User=max
Group=max
WorkingDirectory=/home/max/gemma4-robot
Environment=HOME=/home/max
ExecStart=/home/max/gemma4-robot/bin/gemma-agent-harness --env-file /home/max/gemma4-robot/.env --model gemma-4-31b-it voice-bot --playback-device plughw:1,0 --capture-device plughw:1,0 --startup-greeting=
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
